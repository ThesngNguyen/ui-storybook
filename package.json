{
	"name": "ui-storybook",
	"version": "0.1.0",
	"private": false,
	"license": "MIT",
	"description": "Ant Design v6 component library — customized with vibe. Documented in Storybook 10.",
	"type": "module",
	"main": "./build/index.cjs",
	"module": "./build/index.mjs",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"import": "./build/index.mjs",
			"require": "./build/index.cjs",
			"types": "./build/index.d.ts"
		},
		"./styles": "./build/styles/global.css",
		"./styles/variables": "./build/styles/variables.css",
		"./plugin": {
			"import": "./build/plugin/index.mjs",
			"require": "./build/plugin/index.cjs",
			"types": "./build/plugin/index.d.ts"
		}
	},
	"files": [
		"build",
		"README.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"antd": ">=6.0.0",
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"dependencies": {
		"antd": "^6.5.2",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"scripts": {
		"dev": "storybook dev -p 6006",
		"clean": "rm -rf build mf storybook-static",
		"build": "bun run scripts/build.mjs",
		"build:mf": "cross-env NODE_ENV=production MF_PUBLIC_PATH=auto webpack --config webpack.mf.config.cjs",
		"build:mf:dev": "webpack --config webpack.mf.config.cjs",
		"build:all": "bun run build && bun run build:mf",
		"build-storybook": "storybook build && node scripts/copy-mf.mjs",
		"build:deploy": "bun run build:mf && bun run build-storybook",
		"prepublishOnly": "npm run build:all",
		"test": "react-scripts test",
		"eject": "react-scripts eject"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest",
			"plugin:storybook/recommended"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@babel/core": "^7",
		"@babel/preset-env": "^7",
		"@babel/preset-react": "^7",
		"@babel/preset-typescript": "^7",
		"@biomejs/biome": "2.5.7",
		"@storybook/addon-a11y": "^10.5.3",
		"@storybook/addon-docs": "^10.5.3",
		"@storybook/addon-onboarding": "^10.5.3",
		"@storybook/preset-create-react-app": "^10.5.3",
		"@storybook/react-webpack5": "^10.5.3",
		"babel-loader": "^8",
		"cross-env": "^7",
		"css-loader": "^6",
		"eslint-plugin-storybook": "^10.5.3",
		"prop-types": "^15.8.1",
		"style-loader": "^3",
		"webpack": "^5.108.4",
		"webpack-cli": "^5"
	}
}