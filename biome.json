{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},

	"files": {
		"includes": [
			"src/**/*.js",
			"src/**/*.jsx",
			"src/**/*.ts",
			"src/**/*.tsx",
			"!src/**/*.d.ts",
			"!**/dist/**",
			"!**/node_modules/**"
		],
		"ignoreUnknown": false
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},

	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},

	"json": {
		"formatter": {
			"enabled": true,
			"indentWidth": 2
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
